# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cashfree Payments (Subscriptions API)
# Required for recurring billing integration (Phase 1 currently disabled until credentials configured)
CASHFREE_APP_ID="YOUR_CASHFREE_APP_ID"
CASHFREE_SECRET_KEY="YOUR_CASHFREE_SECRET_KEY"
CASHFREE_API_VERSION="2023-08-01"
CASHFREE_ENV="TEST"

# SMTP Configuration for Pre-Launch Paid Plan Early Access Notifications
# Configure these variables in server environment to enable automatic email delivery to the owner
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="CreatorFlow AI <your-email@gmail.com>"
PLAN_REQUEST_TO="support@creatorflowai.ai.studio"

# Server-Only Owner Identity Configuration (Comma-separated list supported; never expose in frontend bundles)
OWNER_EMAIL="owner@example.com"

# Firebase / Firestore Production Infrastructure
# Match your firebase-applet-config.json projectId and firestoreDatabaseId
FIREBASE_PROJECT_ID="shaped-obelisk-6xctm"
FIRESTORE_DATABASE_ID="ai-studio-remixremixremixr-4b77c6bd-e7aa-4adc-963d-a3b32bf32141"
# Set to "true" in multi-instance Cloud Run / production deployments to fail closed when Firestore is unavailable
CREATORFLOW_REQUIRE_FIRESTORE="false"
# Optional: path to a Google Cloud service account key JSON when running outside GCP with workload identity
GOOGLE_APPLICATION_CREDENTIALS=""

# Secret key for AES-256-GCM encryption of user BYOK Gemini API keys at rest (32+ chars recommended)
BYOK_ENCRYPTION_SECRET=""

